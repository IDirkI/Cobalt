> joint_robot

\link base

\link l1 {
    .mass = 1.0
    .com = {
        .xyz = [0.5, 0, 0]
        .rpy = [0, -pi/2, 0]
    }
}
\link l2 {
    .mass = 1.0
    .com = {
        .xyz = [0.5, 0, 0]
        .rpy = [0, 0, 0]
    }
}

\joint e {
    .links = [base, l1]
    .limits = [[-5, 5], [-5, 5], [-pi, pi]]
    .origin = {
        .xyz = [0, 0, 0]
        .rpy = [0, 0, 0]
    }
    .init = [0.7, 0.5, 0]
    .home = [0, 0, 0]
}

\joint p {
    .links = [l1, l2]
    .limits = [-5, 5]
    .origin = {
        .xyz = [0.5, 0, 0]
        .rpy = [0, -pi/2, 0]
    }
    .init = 0.4
    .home = 0
}


\frame ee {
    .link = l2
    .origin = {
        .xyz = [0.5, 0, 0]
        .rpy = [0, 0, 0]
    }
}